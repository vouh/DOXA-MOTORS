# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-or-anon-key
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# Or the new Supabase secret key name (either works):
# SUPABASE_SECRET_KEY=sb_secret_...

# Database (Supabase PostgreSQL connection string)
DATABASE_URL="postgresql://postgres:[YOUR-PASSWORD]@db.your-project.supabase.co:5432/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres:[YOUR-PASSWORD]@db.your-project.supabase.co:5432/postgres"

# Resend (email notifications)
RESEND_API_KEY=re_your-resend-api-key
FROM_EMAIL=noreply@doxacarhire.com
# Until your domain is verified, ALL emails (including booking confirmations) go here:
RESEND_TEST_EMAIL=your-onboarding@email.com
# Optional: security alerts for suspicious deletes (falls back to RESEND_TEST_EMAIL / Super Admins)
# SECURITY_ALERT_EMAIL=your-onboarding@email.com

# SMS notifications (Africa's Talking or similar)
# Leave placeholders until the SMS account is ready — booking SMS still queues in Notifications.
SMS_API_KEY=your-sms-api-key
SMS_USERNAME=your-sms-username
SMS_SENDER_ID=DOXA

# M-Pesa (Safaricom Daraja)
MPESA_CONSUMER_KEY=your-consumer-key
MPESA_CONSUMER_SECRET=your-consumer-secret
MPESA_SHORTCODE=your-shortcode
MPESA_PASSKEY=your-passkey
MPESA_CALLBACK_URL=https://your-domain.com/api/mpesa/callback

# App
JWT_SECRET=doxa-car-hire-jwt-secret-change-in-production
NEXT_PUBLIC_APP_URL=http://localhost:3002

# Audit log retention (months). Cron: GET /api/cron/purge-audit with Bearer CRON_SECRET
AUDIT_RETENTION_MONTHS=24
CRON_SECRET=change-me-to-a-long-random-string

# Optional error tracking
# SENTRY_DSN=
# NEXT_PUBLIC_SENTRY_DSN=
